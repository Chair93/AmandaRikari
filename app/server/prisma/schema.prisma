generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enums in Prisma — string fields below are validated
// by zod at the API layer. Allowed values are documented per field.

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  /// Bumped on password change/reset so tokens issued before it stop working.
  tokenVersion Int      @default(0)

  memberships          Membership[]
  passwordResetTokens  PasswordResetToken[]
}

/// One business = one shared Rikari workspace. Members access the same data,
/// scoped by role (owner can edit; viewer is read-only).
model Business {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  members      Membership[]
  categories   Category[]
  clients      Client[]
  products     Product[]
  equipment    Equipment[]
  services     Service[]
  transactions Transaction[]
  bills        Bill[]
  recurring    Recurring[]
  packages     Package[]
  appointments Appointment[]
  clientPhotos ClientPhoto[]
  settings     Settings?
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  role       String   @default("owner") // 'owner' | 'viewer'
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
  @@index([businessId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  type       String // 'receita' | 'despesa'
  investment Boolean  @default(false) // despesa marcada como investimento (fora do DRE)

  transactions Transaction[]
  bills        Bill[]
  recurring    Recurring[]

  @@index([businessId])
}

model Client {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  birthday   String? // 'YYYY-MM-DD'
  notes      String?

  transactions Transaction[]
  bills        Bill[]
  packages     Package[]
  appointments Appointment[]
  photos       ClientPhoto[]

  @@index([businessId])
}

/// A photo attached to a client — anamnese forms, before/after shots. The
/// actual image lives OUTSIDE the database as an AES-256-GCM-encrypted file
/// on the volume (see photoStore.ts); this row is only the metadata. Health
/// data gets encryption at rest even in a small clinic.
model ClientPhoto {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// 'anamnese' | 'antes' | 'depois' | 'outra' — fixed set on purpose, so
  /// the gallery filters stay meaningful instead of drowning in free text.
  tipo       String   @default("anamnese")
  /// Atendimento this photo documents (antes/depois) — turns the client's
  /// history into a visual timeline. Cleared if the tx is deleted.
  txId       String?
  tx         Transaction? @relation(fields: [txId], references: [id], onDelete: SetNull)
  mime       String
  size       Int
  createdAt  DateTime @default(now())

  @@index([clientId])
  @@index([businessId])
}

model Product {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  unit        String   @default("ml") // 'ml' | 'g' | 'unidade'
  packageCost Float    @default(0)
  packageQty  Float    @default(1)
  salePrice   Float    @default(0)
  stock       Float    @default(0)
  avgCost     Float    @default(0)
  expiresAt   String? // 'YYYY-MM-DD'
  kind        String   @default("operacional") // 'operacional' | 'descartavel'
  /// Per-product alert threshold: "estoque baixo" fires at stock <= this.
  /// Default 1 preserves the old global behaviour for existing rows.
  lowStockAt  Float    @default(1)

  serviceItems     ServiceItem[]
  transactionItems TransactionItem[]
  sales            TransactionSale[]
  /// Stock purchases ("+ Entrada") booked for this product.
  purchases        Transaction[]

  @@index([businessId])
}

model Equipment {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  kind       String   @default("utensilio") // 'utensilio' | 'maquina'
  qty        Float    @default(1)
  cost       Float    @default(0) // cost per unit
  usefulUses Float    @default(0) // uses per unit until fully depreciated
  kwh        Float    @default(0) // kWh per hour of use (maquina only)
  baixas     Float    @default(0) // units written off
  perdaBaixa Float    @default(0) // undepreciated value lost on write-off
  baixadoEm  String?

  serviceItems     ServiceItem[]
  transactionItems TransactionItem[]
  /// Asset purchases ("+ Compra") booked for this equipment.
  purchases        Transaction[]

  @@index([businessId])
}

model Service {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name       String
  price      Float    @default(0)
  category   String?

  items        ServiceItem[]
  transactions Transaction[]
  packages     Package[]
  appointments Appointment[]

  @@index([businessId])
}

model ServiceItem {
  id          String     @id @default(cuid())
  serviceId   String
  service     Service    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  kind        String // 'product' | 'equipment'
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  qty         Float

  @@index([serviceId])
}

model Transaction {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  type         String // 'receita' | 'despesa'
  amount       Float
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  distanciaKm  Float?
  variableCost Float? // null = despesa sem ficha técnica; number (>=0) = receita com custo calculado
  date         String // 'YYYY-MM-DD'
  note         String?

  // sócio (partner contribution / payout)
  capital     String? // 'aporte' | 'pagamento'
  capitalKind String? // 'capital' | 'emprestimo'
  socio       String?

  payment String? // 'dinheiro' | 'pix' | 'debito' | 'credito'
  /// Credit-card installment count (null/1 = à vista). Drives which fee %
  /// applies and is kept so editing the transaction recomputes correctly.
  parcelas Int?
  feeOf   String? // id of the tx this machine-fee expense belongs to

  prolabore Boolean @default(false)
  estoque   Boolean @default(false) // compra de estoque (investimento)
  ativo     Boolean @default(false) // compra de bem (investimento)

  // Set on the purchase entries created by "+ Entrada" / "+ Compra" so deleting
  // the product or asset can find its own purchases exactly. Matching on the
  // note text used to be the only option and broke as soon as it was renamed.
  productId   String?
  product     Product?   @relation(fields: [productId], references: [id])
  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])

  // True once this atendimento's ficha-técnica product usage was subtracted
  // from stock (fractions of a package). Entries created before fractional
  // consumption existed stay false so editing/deleting them doesn't "return"
  // stock that was never taken.
  consumoBaixado Boolean @default(false)

  // Deferred revenue for prepaid packages: the sale (or installment payoff)
  // moves cash but hasn't been earned yet (cashOnly); using up a session
  // earns its proportional share of revenue without moving new cash
  // (accrualOnly). A normal transaction is neither — cash and revenue move
  // together, same as before this existed.
  cashOnly    Boolean @default(false)
  accrualOnly Boolean @default(false)

  packageId String?
  pkg       Package? @relation(fields: [packageId], references: [id])

  items TransactionItem[]
  sales TransactionSale[]
  /// Agenda appointments fulfilled by this atendimento.
  appointments Appointment[]
  /// Antes/depois photos documenting this atendimento.
  photos       ClientPhoto[]

  createdAt DateTime @default(now())

  @@index([businessId])
  @@index([businessId, date])
  @@index([clientId])
}

model TransactionItem {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  kind          String // 'product' | 'equipment'
  productId     String?
  product       Product?    @relation(fields: [productId], references: [id])
  equipmentId   String?
  equipment     Equipment?  @relation(fields: [equipmentId], references: [id])
  qty           Float

  @@index([transactionId])
}

model TransactionSale {
  id            String      @id @default(cuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  qty           Float
  unitPrice     Float
  unitCost      Float

  @@index([transactionId])
}

model Settings {
  id                String   @id @default(cuid())
  businessId        String   @unique
  business          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  energyPricePerKwh Float    @default(0)
  costPerKm         Float    @default(0)
  prolaboreMode     String   @default("pct") // 'pct' | 'fixo'
  prolaborePct      Float    @default(0)
  prolaboreFixo     Float    @default(0)
  metaMensal        Float    @default(0)
  taxaCredito       Float    @default(0)
  taxaDebito        Float    @default(0)
  taxaPix           Float    @default(0)
  /// JSON map of credit-card fee % per installment count ({"2":6.09,...}).
  /// 1x uses taxaCredito; counts missing from the map fall back to it too.
  taxaCreditoParcelas String @default("{}")
  emailDigestEnabled Boolean @default(false)
  /// Nightly e-mail with the full JSON backup — sent only when something
  /// changed since the last one that went out. Opt-out: it's a safety net.
  emailBackupEnabled Boolean @default(true)
  /// Issuer block printed on receipts (and, one day, invoices).
  receiptDoc         String  @default("") // CPF/CNPJ
  receiptPhone       String  @default("")
  receiptAddress     String  @default("")
  receiptCity        String  @default("")
  /// Rented treatment room: what the space owner charges per atendimento.
  /// 'off' = no rented room; 'fixo' = salaFixo reais each; 'pct' = salaPct%
  /// of the atendimento's value. Books an automatic despesa like the
  /// card-machine fee does.
  salaMode           String  @default("off") // 'off' | 'fixo' | 'pct'
  salaFixo           Float   @default(0)
  salaPct            Float   @default(0)
  /// Who the room is rented from — names the monthly conta a pagar.
  salaOwner          String  @default("")
  /// WhatsApp reminder template for Agenda. Placeholders {nome}, {data},
  /// {hora}, {servico} are filled client-side. Empty = built-in default.
  waTemplate         String  @default("")
  /// Birthday congratulation template ({nome}). Empty = built-in default.
  waBirthday         String  @default("")
  /// Win-back message for clients who stopped coming ({nome}).
  waReactivation     String  @default("")
  agendaStartHour    Int     @default(9)
  agendaEndHour      Int     @default(19)
  agendaSlotMin      Int     @default(30)
}

model Bill {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String // 'pagar' | 'receber'
  desc       String
  amount     Float
  due        String // 'YYYY-MM-DD'
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id])
  note       String?
  recorrente Boolean   @default(false)
  settled    Boolean   @default(false)
  settledAt  String?
  txId       String?
  recId      String?
  /// 'YYYY-MM' this recurring bill was generated for. Unique together with
  /// recId so two concurrent requests can't both create the same month's bill.
  recMonth   String?
  /// The month's accumulated room-rental debt (uso de sala). recMonth holds
  /// which month it accumulates for; atendimentos add to it, deleting them
  /// subtracts, and settling it is what actually pays the room owner.
  sala       Boolean   @default(false)
  // Set when this bill is an installment of a package sold "a prazo" — lets
  // settlement flag the resulting transaction cashOnly (paying an
  // installment moves cash but doesn't itself earn revenue).
  packageId  String?
  package    Package?  @relation(fields: [packageId], references: [id])

  @@unique([recId, recMonth])
  @@index([businessId])
}

model Recurring {
  id         String    @id @default(cuid())
  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  desc       String
  amount     Float
  dueDay     Int       @default(5)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  geradas    String    @default("[]") // JSON array of 'YYYY-MM' month keys already generated

  @@index([businessId])
}

model Package {
  id           String        @id @default(cuid())
  businessId   String
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client        @relation(fields: [clientId], references: [id])
  serviceId    String?
  service      Service?      @relation(fields: [serviceId], references: [id])
  sessions     Int
  used         Int           @default(0)
  amount       Float
  date         String
  aprazo       Boolean       @default(false)
  parcelas     Int?
  transactions Transaction[]
  bills        Bill[]

  @@index([businessId])
}

model Appointment {
  id          String   @id @default(cuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id])
  date        String // 'YYYY-MM-DD'
  time        String // 'HH:MM'
  durationMin Int      @default(60)
  status      String   @default("confirmed") // 'confirmed' | 'cancelled'
  /// Client replied to the reminder confirming they'll show up. Separate
  /// from status: 'confirmed' there means "booked", not "answered".
  confirmou   Boolean  @default(false)
  note        String?
  /// The atendimento (transaction) registered from this appointment — lets
  /// the Agenda show what actually happened. Cleared if the tx is deleted.
  txId        String?
  tx          Transaction? @relation(fields: [txId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([businessId])
}
